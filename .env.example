# Copiar a .env y completar con valores reales. El archivo .env no se commitea.
# Lo leen docker compose (para crear la base) y la aplicación (para conectarse).

# Base de datos propia del servicio de catálogo
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catalogo
DB_USERNAME=catalogo
DB_PASSWORD=cambiar-esta-password

# Servicio central de la cátedra (cuenta técnica del proyecto, anexo §5)
CATEDRA_API_URL=http://servidor-catedra:8090
CATEDRA_JWT=pegar-aca-el-jwt-tecnico
